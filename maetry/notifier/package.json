{
  "name": "@maetry/zitadel-notifier",
  "version": "0.1.0",
  "description": "Delivers ZITADEL email and SMS notifications through Telnyx",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --strict-vars=false",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.126.0"
  }
}
