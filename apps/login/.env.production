# MAETRY: Login V2 theme for auth.maetry.com (see MAETRY.md).
# NEXT_PUBLIC_* values are inlined by `next build`, so changing them needs a rebuild
# and a redeploy of the Worker. Options are described in .env.theme.example.
# Chosen 2026-10-15 on a local preview: glass, fully rounded.

# edgy | mid | full — applies to every component; unset keeps the per-component
# defaults (mid, with avatars and the theme switch full)
NEXT_PUBLIC_THEME_ROUNDNESS=full
# side-by-side | top-to-bottom
NEXT_PUBLIC_THEME_LAYOUT=top-to-bottom
# regular | compact
NEXT_PUBLIC_THEME_SPACING=regular
# flat | material | glass
NEXT_PUBLIC_THEME_APPEARANCE=glass
# Path under public/ or an absolute URL; empty means a solid background
NEXT_PUBLIC_THEME_BACKGROUND_IMAGE=
